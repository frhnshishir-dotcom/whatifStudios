{
  "name": "lumenwild",
  "version": "0.1.0",
  "private": true,
  "description": "Lumenwild: an interactive ASCII fantasy nature simulator (Canvas 2D, CPU-first).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "server:build": "vite build --ssr server/main.ts --outDir dist-server --emptyOutDir",
    "server": "npm run server:build && node dist-server/main.js",
    "loadtest": "vitest run tests/load.test.ts --silent=false"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/dejavu-mono": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
